{
  "openapi": "3.1.0",
  "info": {
    "title": "Weather Alerts API",
    "description": "Subscribe to severe weather alerts for a location.",
    "version": "2.0.0"
  },
  "paths": {
    "/alerts": {
      "get": {
        "summary": "List active alerts",
        "description": "Return the alerts in effect now, newest first.",
        "parameters": [
          {
            "name": "zone",
            "in": "query",
            "description": "zone code, such as `WAZ558`.",
            "schema": { "type": "string" }
          },
          {
            "name": "urgent",
            "in": "query",
            "description": "True if only immediate alerts are returned.",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": { "200": { "description": "The alerts." } }
      }
    },
    "/subscriptions": {
      "post": {
        "summary": "Creates a subscription.",
        "description": "Send each new alert for a zone to a webhook url",
        "responses": { "201": { "description": "The subscription." } }
      }
    }
  },
  "webhooks": {
    "alertIssued": {
      "post": {
        "summary": "Delivers an alert",
        "description": "Deliver an alert alert to the subscriber's webhook as JSON.",
        "responses": { "200": { "description": "Received." } }
      }
    }
  },
  "components": {
    "schemas": {
      "Alert": {
        "description": "A warning, watch, or advisory.",
        "type": "object",
        "properties": {
          "headline": { "type": "string", "description": "Headline" },
          "expired": { "type": "boolean", "description": "Whether the alert has ended." }
        }
      }
    }
  }
}
